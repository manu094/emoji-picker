<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>Emoji Picker</title>
<style>
* { box-sizing: border-box; margin: 0; padding: 0; }
:root {
  --esz:   21px;
  --buf-h: 116px;
  --bg:      #1e1e2e;
  --surf:    #2a2a3e;
  --bord:    rgba(255,255,255,.08);
  --text:    #cdd6f4;
  --muted:   #6c7086;
  --acc:     #89b4fa;
  --hover:   rgba(255,255,255,.06);
  --sel:     rgba(137,180,250,.22);
  --buf-bg:  rgba(137,180,250,.04);
  --buf-cur: rgba(137,180,250,.08);
  --n:       #a6e3a1;
  --s:       #f9e2af;
  --c:       #cba6f7;
  --font:    'Segoe UI', system-ui, sans-serif;
}
html, body { width:100%; height:100%; overflow:hidden; }
body {
  font-family: var(--font);
  background: var(--bg);
  color: var(--text);
  display: flex;
  flex-direction: column;
  user-select: none;
}

/* ── Top bar ─────────────────────────────────────────── */
#top {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 5px 10px;
  border-bottom: 1px solid var(--bord);
  flex-shrink: 0;
  height: 30px;
}
#mode-badge {
  font-size: 11px; font-weight: 700;
  letter-spacing: .1em; color: var(--n); flex-shrink: 0;
}
#srch-ind {
  font-size: 11px; color: var(--muted); flex: 1;
  overflow: hidden; white-space: nowrap; text-overflow: ellipsis;
}
#srch-input {
  flex: 1; background: transparent; border: none;
  color: var(--text); font: 12px var(--font); outline: none;
}
#srch-input::placeholder { color: var(--muted); }
#cmd-disp { font-size: 12px; color: var(--c); font-family: monospace; flex: 1; }
.gone { display: none !important; }

/* ── Category tabs ───────────────────────────────────── */
#cats {
  display: flex; gap: 1px; padding: 4px 6px;
  border-bottom: 1px solid var(--bord);
  flex-shrink: 0; overflow-x: auto; scrollbar-width: none;
}
#cats::-webkit-scrollbar { display: none; }
.cat-btn {
  background: none; border: none; cursor: pointer;
  font-size: 17px; padding: 4px 6px; border-radius: 5px;
  line-height: 1; flex-shrink: 0; opacity: .55; color: inherit;
  transition: background .1s, opacity .1s;
}
.cat-btn:hover  { background: var(--hover); opacity: 1; }
.cat-btn.active { background: var(--sel);   opacity: 1; }

/* ── Emoji grid ──────────────────────────────────────── */
#grid-wrap {
  flex: 1; overflow-y: auto; min-height: 0;
  scrollbar-width: thin; scrollbar-color: var(--surf) transparent;
}
#grid { display: grid; grid-template-columns: repeat(9, 1fr); padding: 4px; }
.sec-lbl {
  grid-column: 1 / -1;
  font-size: 9px; font-weight: 600; letter-spacing: .08em;
  text-transform: uppercase; color: var(--muted); padding: 6px 4px 2px;
}
.no-res {
  grid-column: 1 / -1;
  text-align: center; color: var(--muted); font-size: 12px; padding: 28px 0;
}
.ebtn {
  position: relative; background: none; border: none; cursor: pointer;
  font-size: var(--esz); line-height: 1;
  height: calc(var(--esz) + 14px); overflow: hidden;
  display: flex; align-items: center; justify-content: center;
  border-radius: 5px; color: inherit;
  transition: background .08s, transform .07s;
}
.ebtn:hover   { background: var(--hover); transform: scale(1.12); }
.ebtn:active  { transform: scale(.94); }
.ebtn.focused { background: var(--sel); }
.ubadge {
  position: absolute; top: 1px; right: 2px;
  font-size: 7px; color: var(--muted); line-height: 1; pointer-events: none;
}

/* ── Buffer ──────────────────────────────────────────── */
#buf {
  border-top: 1px solid var(--bord); padding: 5px 10px 4px;
  flex-shrink: 0; max-height: var(--buf-h); overflow-y: auto;
  scrollbar-width: thin; scrollbar-color: var(--surf) transparent;
  background: var(--buf-bg);
}
.bline {
  font-size: 18px; line-height: 1.45; min-height: 26px;
  display: flex; align-items: center; flex-wrap: wrap;
  border-radius: 3px; padding: 0 3px;
}
.bline.cur { background: var(--buf-cur); }
.bcur {
  display: inline-block; color: var(--acc); font-size: 15px; font-weight: 700;
  animation: blink 1.1s step-end infinite;
}
@keyframes blink { 50% { opacity: 0; } }
.bempty { font-size: 11px; color: var(--muted); padding: 3px 0; }
.bdot   { color: var(--muted); font-size: 12px; opacity: .45; }

/* ── Hints bar ───────────────────────────────────────── */
#hints {
  display: flex; align-items: center; gap: 8px; padding: 4px 10px;
  border-top: 1px solid var(--bord); flex-shrink: 0; height: 26px;
}
#prev-em { font-size: 17px; line-height: 1; flex-shrink: 0; }
#prev-nm { font-size: 10px; color: var(--muted); flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
#hint-t  { font-size: 9.5px; color: var(--muted); white-space: nowrap; flex-shrink: 0; }

/* ── Help overlay ────────────────────────────────────── */
#help-ov {
  position: fixed; inset: 0; z-index: 100;
  background: rgba(0,0,0,.55);
  display: flex; align-items: center; justify-content: center;
}
#help-box {
  background: var(--surf); border: 1px solid var(--bord);
  border-radius: 8px; padding: 14px 18px;
  max-width: 92%; max-height: 78vh; overflow-y: auto;
  scrollbar-width: thin; scrollbar-color: var(--bg) transparent;
}
.help-h {
  font-size: 10px; font-weight: 700; letter-spacing: .1em;
  text-transform: uppercase; color: var(--acc);
  margin: 10px 0 4px;
}
.help-h:first-child { margin-top: 0; }
.help-row { display: flex; gap: 10px; font-size: 11px; margin: 2px 0; }
.help-k { color: var(--s); font-family: monospace; min-width: 140px; flex-shrink: 0; }
.help-d { color: var(--muted); }
</style>
</head>
<body>

<div id="top">
  <span id="mode-badge">NORMAL</span>
  <span id="srch-ind"  class="gone"></span>
  <input id="srch-input" class="gone" type="text" placeholder="Search…" autocomplete="off" spellcheck="false">
  <span id="cmd-disp"  class="gone"></span>
</div>

<div id="cats"></div>
<div id="grid-wrap"><div id="grid"></div></div>
<div id="buf"></div>

<div id="hints">
  <span id="prev-em"></span>
  <span id="prev-nm"></span>
  <span id="hint-t"></span>
</div>

<div id="help-ov" class="gone">
  <div id="help-box">
    <div class="help-h">Normal mode</div>
    <div class="help-row"><span class="help-k">h j k l / arrows</span><span class="help-d">move grid cursor</span></div>
    <div class="help-row"><span class="help-k">Tab</span><span class="help-d">insert emoji into buffer</span></div>
    <div class="help-row"><span class="help-k">Enter</span><span class="help-d">send buffer (or focused emoji)</span></div>
    <div class="help-row"><span class="help-k">0–9</span><span class="help-d">quick-insert 1st–10th emoji</span></div>
    <div class="help-row"><span class="help-k">H J K L</span><span class="help-d">move buffer cursor</span></div>
    <div class="help-row"><span class="help-k">x / Backspace</span><span class="help-d">delete from buffer</span></div>
    <div class="help-row"><span class="help-k">Shift+Backspace</span><span class="help-d">clear entire buffer</span></div>
    <div class="help-row"><span class="help-k">dd</span><span class="help-d">delete current buffer line</span></div>
    <div class="help-row"><span class="help-k">dG</span><span class="help-d">delete all buffer lines</span></div>
    <div class="help-row"><span class="help-k">o / O</span><span class="help-d">new line below / above in buffer</span></div>
    <div class="help-row"><span class="help-k">[ / ]</span><span class="help-d">prev / next category</span></div>
    <div class="help-row"><span class="help-k">g1–g9, g0</span><span class="help-d">jump to category 1–10 ([ / ] for all 12)</span></div>
    <div class="help-row"><span class="help-k">/</span><span class="help-d">enter search mode</span></div>
    <div class="help-row"><span class="help-k">:</span><span class="help-d">enter command mode</span></div>
    <div class="help-row"><span class="help-k">Esc</span><span class="help-d">close (save buffer)</span></div>
    <div class="help-h">Search mode</div>
    <div class="help-row"><span class="help-k">Tab</span><span class="help-d">insert first result</span></div>
    <div class="help-row"><span class="help-k">Enter</span><span class="help-d">insert first result + send</span></div>
    <div class="help-row"><span class="help-k">Esc</span><span class="help-d">exit search</span></div>
    <div class="help-h">Commands  (Tab / Shift+Tab to complete)</div>
    <div class="help-row"><span class="help-k">:q  :q!</span><span class="help-d">close, discard buffer</span></div>
    <div class="help-row"><span class="help-k">:wq  :wq!</span><span class="help-d">close, save buffer</span></div>
    <div class="help-row"><span class="help-k">:colorscheme &lt;name&gt;</span><span class="help-d">mocha · latte · gruvbox · nord · dracula</span></div>
    <div class="help-row"><span class="help-k">:skin &lt;0–5&gt;</span><span class="help-d">skin tone (0 = default yellow)</span></div>
    <div class="help-row"><span class="help-k">:set cols &lt;n&gt;</span><span class="help-d">grid column count (3–20)</span></div>
    <div class="help-row"><span class="help-k">:set size &lt;n&gt;</span><span class="help-d">emoji font size in px (10–64)</span></div>
    <div class="help-row"><span class="help-k">:set buf &lt;n&gt;</span><span class="help-d">max buffer height in px</span></div>
    <div class="help-row"><span class="help-k">:set halflife &lt;days&gt;</span><span class="help-d">Most Used recency decay (default 5)</span></div>
    <div class="help-row"><span class="help-k">:set win &lt;w&gt; &lt;h&gt;</span><span class="help-d">resize window to exact pixels</span></div>
    <div class="help-row"><span class="help-k">:clearhistory</span><span class="help-d">clear Most Used stats</span></div>
    <div class="help-row"><span class="help-k">:reset</span><span class="help-d">factory reset all settings</span></div>
    <div class="help-row"><span class="help-k">:help</span><span class="help-d">show this screen</span></div>
  </div>
</div>

<script>
// ════════════════════════════════════════════════════════
