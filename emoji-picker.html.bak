  '👨‍🎤','👨‍🎨','👨‍🏫','👨‍🏭','👨‍💻','👨‍💼',
  '👨‍🔧','👨‍🔬','👨‍🚀','👨‍🚒','👨‍🤝‍👨','👨‍🦯',
  '👨‍🦯‍➡️','👨‍🦰','👨‍🦱','👨‍🦲','👨‍🦳','👨‍🦼',
  '👨‍🦼‍➡️','👨‍🦽','👨‍🦽‍➡️','👩','👩‍⚕️','👩‍⚖️',
  '👩‍✈️','👩‍❤️‍👨','👩‍❤️‍👩','👩‍❤️‍💋‍👨','👩‍❤️‍💋‍👩','👩‍🌾',
  '👩‍🍳','👩‍🍼','👩‍🎓','👩‍🎤','👩‍🎨','👩‍🏫',
  '👩‍🏭','👩‍💻','👩‍💼','👩‍🔧','👩‍🔬','👩‍🚀',
  '👩‍🚒','👩‍🤝‍👨','👩‍🤝‍👩','👩‍🦯','👩‍🦯‍➡️','👩‍🦰',
  '👩‍🦱','👩‍🦲','👩‍🦳','👩‍🦼','👩‍🦼‍➡️','👩‍🦽',
  '👩‍🦽‍➡️','👫','👬','👭','👮','👮‍♀️',
  '👮‍♂️','👰','👰‍♀️','👰‍♂️','👱','👱‍♀️',
  '👱‍♂️','👲','👳','👳‍♀️','👳‍♂️','👴',
  '👵','👶','👷','👷‍♀️','👷‍♂️','👸',
  '👼','💁','💁‍♀️','💁‍♂️','💂','💂‍♀️',
  '💂‍♂️','💃','💅','💆','💆‍♀️','💆‍♂️',
  '💇','💇‍♀️','💇‍♂️','💏','💑','💪',
  '🕴','🕵','🕵‍♀️','🕵‍♂️','🕺','🖐',
  '🖕','🖖','🙅','🙅‍♀️','🙅‍♂️','🙆',
  '🙆‍♀️','🙆‍♂️','🙇','🙇‍♀️','🙇‍♂️','🙋',
  '🙋‍♀️','🙋‍♂️','🙌','🙍','🙍‍♀️','🙍‍♂️',
  '🙎','🙎‍♀️','🙎‍♂️','🙏','🚣','🚣‍♀️',
  '🚣‍♂️','🚴','🚴‍♀️','🚴‍♂️','🚵','🚵‍♀️',
  '🚵‍♂️','🚶','🚶‍♀️','🚶‍♀️‍➡️','🚶‍♂️','🚶‍♂️‍➡️',
  '🚶‍➡️','🛀','🛌','🤌','🤏','🤘',
  '🤙','🤚','🤛','🤜','🤝','🤞',
  '🤟','🤦','🤦‍♀️','🤦‍♂️','🤰','🤱',
  '🤲','🤳','🤴','🤵','🤵‍♀️','🤵‍♂️',
  '🤶','🤷','🤷‍♀️','🤷‍♂️','🤸','🤸‍♀️',
  '🤸‍♂️','🤹','🤹‍♀️','🤹‍♂️','🤽','🤽‍♀️',
  '🤽‍♂️','🤾','🤾‍♀️','🤾‍♂️','🥷','🦵',
  '🦶','🦸','🦸‍♀️','🦸‍♂️','🦹','🦹‍♀️',
  '🦹‍♂️','🦻','🧍','🧍‍♀️','🧍‍♂️','🧎',
  '🧎‍♀️','🧎‍♀️‍➡️','🧎‍♂️','🧎‍♂️‍➡️','🧎‍➡️','🧏',
  '🧏‍♀️','🧏‍♂️','🧑','🧑‍⚕️','🧑‍⚖️','🧑‍✈️',
  '🧑‍❤️‍💋‍🧑','🧑‍❤️‍🧑','🧑‍🌾','🧑‍🍳','🧑‍🍼','🧑‍🎄',
  '🧑‍🎓','🧑‍🎤','🧑‍🎨','🧑‍🏫','🧑‍🏭','🧑‍💻',
  '🧑‍💼','🧑‍🔧','🧑‍🔬','🧑‍🚀','🧑‍🚒','🧑‍🤝‍🧑',
  '🧑‍🦯','🧑‍🦯‍➡️','🧑‍🦰','🧑‍🦱','🧑‍🦲','🧑‍🦳',
  '🧑‍🦼','🧑‍🦼‍➡️','🧑‍🦽','🧑‍🦽‍➡️','🧒','🧓',
  '🧔','🧔‍♀️','🧔‍♂️','🧕','🧖','🧖‍♀️',
  '🧖‍♂️','🧗','🧗‍♀️','🧗‍♂️','🧘','🧘‍♀️',
  '🧘‍♂️','🧙','🧙‍♀️','🧙‍♂️','🧚','🧚‍♀️',
  '🧚‍♂️','🧛','🧛‍♀️','🧛‍♂️','🧜','🧜‍♀️',
  '🧜‍♂️','🧝','🧝‍♀️','🧝‍♂️','🫃','🫄',
  '🫅','🫰','🫱','🫱‍🫲','🫲','🫳',
  '🫴','🫵','🫶','🫷','🫸',
]);

// ════════════════════════════════════════════════════════
//  STATE
// ════════════════════════════════════════════════════════
let mode    = 'normal';  // 'normal' | 'search' | 'command'
let cat     = '_top';    // active category key
let gc      = 0;         // grid cursor index into vis[]
let vis     = [];        // [{e, d}] — visible emojis
let visPos  = [];        // [{row, col}] — visual grid position per vis entry
let buf     = [[]];      // string[][] — 2D emoji buffer
let bc      = {l:0,c:0}; // buffer cursor {line, col}
let srchQ   = '';        // search query
let usage   = {};        // {emoji: count}
let pendKey = null;      // 'd' / 'g' pending key
let pendTmr = null;
let skinTone = 0;
let naturalColW = 49;    // px per column at natural size, captured at startup
let halfLife  = 5;       // days for usage score half-life
let emojiSize = 21;      // px, emoji font size in grid
let bufHeight = 116;     // px, max buffer area height

// ════════════════════════════════════════════════════════
//  STORAGE
// ════════════════════════════════════════════════════════
try { usage = JSON.parse(localStorage.getItem('ep_u') || '{}'); } catch(e) { usage = {}; }
try {
  const saved = JSON.parse(localStorage.getItem('ep_b') || 'null');
  if (Array.isArray(saved) && saved.length) { buf = saved; bc = {l: saved.length - 1, c: saved[saved.length-1].length}; }
} catch(e) {}
try { const t = localStorage.getItem('ep_theme'); if (t && THEMES[t]) applyTheme(t); } catch(e) {}
try { skinTone  = Math.max(0, Math.min(5,  parseInt(localStorage.getItem('ep_skin') || '0'))); } catch(e) {}
try { COLS      = Math.max(3, Math.min(20, parseInt(localStorage.getItem('ep_cols') || '9'))); } catch(e) {}
try { halfLife  = Math.max(0.1, parseFloat(localStorage.getItem('ep_hl')  || '5'));  } catch(e) {}
try { emojiSize = Math.max(10, Math.min(64, parseInt(localStorage.getItem('ep_sz')  || '21'))); } catch(e) {}
try { bufHeight = Math.max(26, parseInt(localStorage.getItem('ep_bh') || '116')); } catch(e) {}

// ════════════════════════════════════════════════════════
//  DOM REFS
// ════════════════════════════════════════════════════════
const $mb = document.getElementById('mode-badge');
const $si = document.getElementById('srch-input');
const $sd = document.getElementById('srch-ind');
const $cd = document.getElementById('cmd-disp');
const $gc = document.getElementById('cats');
const $gr = document.getElementById('grid');
const $bf = document.getElementById('buf');
const $pe = document.getElementById('prev-em');
const $pn = document.getElementById('prev-nm');
const $ht = document.getElementById('hint-t');

// ════════════════════════════════════════════════════════
//  CLIPBOARD (synchronous — keeps user gesture alive)
// ════════════════════════════════════════════════════════
function clipWrite(text) {
  const t = document.createElement('textarea');
  t.value = text;
  t.style.cssText = 'position:fixed;opacity:0;top:0;left:0';
  document.body.appendChild(t);
  t.select();
  try { document.execCommand('copy'); } catch(e) {}
  document.body.removeChild(t);
}

// ════════════════════════════════════════════════════════
//  HELPERS
// ════════════════════════════════════════════════════════
function getCount(e) {
  const u = usage[e];
  return !u ? 0 : typeof u === 'object' ? u.n : u;
}
function usageScore(e) {
  const u = usage[e];
  if (!u) return 0;
  const n = typeof u === 'object' ? u.n : u;
  const t = typeof u === 'object' ? u.t : Date.now();
  return n * Math.pow(0.5, (Date.now() - t) / (halfLife * 86400000));
}
function withTone(em) {
  if (!skinTone) return em;
  const base = em.replace(/️/g, '');
  if (!TONE_SUPPORTED.has(em) && !TONE_SUPPORTED.has(base)) return em;
  const zwj = base.indexOf('‍');
  if (zwj !== -1) return base.slice(0, zwj) + TONE_CHARS[skinTone] + base.slice(zwj);
  return base + TONE_CHARS[skinTone];
}
function applyCols()      { $gr.style.gridTemplateColumns = `repeat(${COLS}, 1fr)`; }
function applySize()      { document.documentElement.style.setProperty('--esz',   emojiSize + 'px'); }
function applyBufHeight() { document.documentElement.style.setProperty('--buf-h', bufHeight + 'px'); }

// ════════════════════════════════════════════════════════
//  BUFFER OPS
// ════════════════════════════════════════════════════════
function bInsert(em) {
  if (!buf[bc.l]) buf[bc.l] = [];
  buf[bc.l].splice(bc.c, 0, em);
  bc.c++;
}
function bDelBack() {
  if (bc.c > 0) { buf[bc.l].splice(bc.c - 1, 1); bc.c--; }
  else if (bc.l > 0) {
    const prev = buf.splice(bc.l, 1)[0];
    bc.l--;
    bc.c = buf[bc.l].length;
    buf[bc.l] = buf[bc.l].concat(prev);
  }
}
function bDelLine() {
  if (buf.length === 1) { buf = [[]]; bc = {l:0, c:0}; return; }
  buf.splice(bc.l, 1);
  if (bc.l >= buf.length) bc.l = buf.length - 1;
  bc.c = Math.min(bc.c, buf[bc.l].length);
}
function bDelAll() { buf = [[]]; bc = {l:0, c:0}; }
function bLineBelow() { buf.splice(bc.l + 1, 0, []); bc.l++; bc.c = 0; }
function bLineAbove() { buf.splice(bc.l, 0, []); bc.c = 0; }
function bH() { if (bc.c > 0) bc.c--; }
function bL() { bc.c = Math.min(bc.c + 1, buf[bc.l].length); }
function bJ() { if (bc.l < buf.length - 1) { bc.l++; bc.c = Math.min(bc.c, buf[bc.l].length); } }
function bK() { if (bc.l > 0) { bc.l--; bc.c = Math.min(bc.c, buf[bc.l].length); } }
function bTotal() { return buf.reduce((s, l) => s + l.length, 0); }
function bStr()   { return buf.map(l => l.join('')).join('\n'); }

// ════════════════════════════════════════════════════════
//  SEND / CLOSE
// ════════════════════════════════════════════════════════
function doSend(fallback) {
  if (bTotal() === 0) {
    if (!fallback) return;
    buf = [[fallback]];
  }
  const text = bStr();
  const now = Date.now();
  const toneRe = /[\u{1F3FB}-\u{1F3FF}]/gu;
  buf.forEach(line => line.forEach(em => {
    const base = em.replace(toneRe, '');
    usage[base] = { n: getCount(base) + 1, t: now };
  }));
  try { localStorage.setItem('ep_u', JSON.stringify(usage)); } catch(e) {}
  try { localStorage.removeItem('ep_b'); } catch(e) {}
  clipWrite('EP:' + text);
  setTimeout(() => { try { window.close(); } catch(e) {} }, 300);
}

function doCloseKeep() {
  try { localStorage.setItem('ep_b', JSON.stringify(buf)); } catch(e) {}
  try { window.close(); } catch(e) {}
}

function doCloseDrop() {
  try { localStorage.removeItem('ep_b'); } catch(e) {}
  try { window.close(); } catch(e) {}
}

// ════════════════════════════════════════════════════════
//  GRID CURSOR
// ════════════════════════════════════════════════════════
function setGC(i) {
  if (!vis.length) return;
  gc = Math.max(0, Math.min(i, vis.length - 1));
  // Scroll focused button into view
  const btns = $gr.querySelectorAll('.ebtn');
  if (btns[gc]) btns[gc].scrollIntoView({block:'nearest'});
  drawGrid();
  drawUI();
}

// Navigate by visual rows — skips label/gap rows
function gridByPos(dr) {
  if (!vis.length || gc >= visPos.length) return;
  const {row: cr, col: cc} = visPos[gc];

  // Build ordered list of occupied rows
  const seen = new Set();
  const rows = [];
  visPos.forEach(p => { if (!seen.has(p.row)) { seen.add(p.row); rows.push(p.row); } });

  const ci = rows.indexOf(cr);
  const ti = ci + dr;
  if (ti < 0 || ti >= rows.length) return;
  const targetRow = rows[ti];

  // Pick emoji in target row closest to current column
  const inRow = visPos.reduce((acc, p, i) => { if (p.row === targetRow) acc.push(i); return acc; }, []);
  let best = inRow[0], bestDist = Math.abs(visPos[inRow[0]].col - cc);
  for (const i of inRow) {
    const d = Math.abs(visPos[i].col - cc);
    if (d < bestDist) { best = i; bestDist = d; }
  }
  setGC(best);
}

// ════════════════════════════════════════════════════════
//  SEARCH / COMMAND MODE
// ════════════════════════════════════════════════════════
let cmdTxt = '';

function enterSearch() {
  mode = 'search'; srchQ = ''; $si.value = '';
  drawGrid(); drawUI();
  $si.focus();
}

function exitSearch() {
  srchQ = $si.value;
  mode = 'normal';
  $si.blur();
  drawGrid(); drawUI();
}

function enterCmd() {
  mode = 'command'; cmdTxt = '';
  drawUI();
}

function enterHelp() {
  exitCmd();
  mode = 'help';
  document.getElementById('help-ov').classList.remove('gone');
  drawUI();
}

function exitHelp() {
  mode = 'normal';
  document.getElementById('help-ov').classList.add('gone');
  drawUI();
}

let tabCandidates = [];
let tabIdx = 0;
function resetTab() { tabCandidates = []; tabIdx = 0; }

function cmdComplete(dir) {
  const CS = 'colorscheme ';
  const ALL = ['clearhistory', 'colorscheme ', 'help', 'q', 'q!', 'reset', 'set buf ', 'set cols ', 'set halflife ', 'set size ', 'set win ', 'skin ', 'wq', 'wq!'];

  if (tabCandidates.length) {
    tabIdx = (tabIdx + dir + tabCandidates.length) % tabCandidates.length;
    cmdTxt = tabCandidates[tabIdx];
    drawUI();
    return;
  }

  let candidates;
  if (cmdTxt.startsWith(CS)) {
    const partial = cmdTxt.slice(CS.length);
    candidates = Object.keys(THEMES).filter(n => n.startsWith(partial)).map(n => CS + n).sort();
  } else {
    candidates = ALL.filter(c => c.startsWith(cmdTxt) && c !== cmdTxt).sort();
  }
  if (!candidates.length) return;

  if (candidates.length === 1) { cmdTxt = candidates[0]; drawUI(); return; }

  tabCandidates = candidates;
  tabIdx = dir === 1 ? 0 : candidates.length - 1;
  cmdTxt = candidates[tabIdx];
  drawUI();
}

function exitCmd() {
  mode = 'normal'; cmdTxt = '';
  resetTab();
  drawUI();
}

function execCmd() {
  const c = cmdTxt.trim();
  if (c === 'q' || c === 'q!')   { doCloseDrop(); return; }
  if (c === 'wq' || c === 'wq!') { doCloseKeep(); return; }
  if (c === 'help') { enterHelp(); return; }
  if (c === 'clearhistory') {
    usage = {};
    try { localStorage.removeItem('ep_u'); } catch(e) {}
    drawGrid(); exitCmd(); return;
  }
  if (c === 'reset') {
    usage = {}; buf = [[]]; bc = {l:0,c:0};
    skinTone = 0; COLS = 9; halfLife = 5; emojiSize = 21; bufHeight = 116;
    ['ep_u','ep_b','ep_theme','ep_skin','ep_cols','ep_hl','ep_sz','ep_bh'].forEach(k => {
      try { localStorage.removeItem(k); } catch(e) {}
    });
    applyTheme('mocha'); applyCols(); applySize(); applyBufHeight();
    drawCats(); drawGrid(); exitCmd(); return;
  }
  const csMatch = c.match(/^colorscheme\s+(\S+)$/);
  if (csMatch) {
    const name = csMatch[1];
    if (applyTheme(name)) { try { localStorage.setItem('ep_theme', name); } catch(e) {} }
    exitCmd(); return;
  }
  const skinMatch = c.match(/^skin\s+([0-5])$/);
  if (skinMatch) {
    skinTone = parseInt(skinMatch[1]);
    try { localStorage.setItem('ep_skin', skinTone); } catch(e) {}
    drawGrid(); exitCmd(); return;
  }
  const colsMatch = c.match(/^set\s+cols\s+(\d+)$/);
  if (colsMatch) {
    COLS = Math.max(3, Math.min(20, parseInt(colsMatch[1])));
    try { localStorage.setItem('ep_cols', COLS); } catch(e) {}
    window.resizeTo(Math.max(naturalColW * COLS, 300), window.outerHeight);
    applyCols(); drawGrid(); exitCmd(); return;
  }
  const hlMatch = c.match(/^set\s+halflife\s+(\d+(?:\.\d+)?)$/);
  if (hlMatch) {
    halfLife = Math.max(0.1, parseFloat(hlMatch[1]));
    try { localStorage.setItem('ep_hl', halfLife); } catch(e) {}
    exitCmd(); return;
  }
  const szMatch = c.match(/^set\s+size\s+(\d+)$/);
  if (szMatch) {
    emojiSize = Math.max(10, Math.min(64, parseInt(szMatch[1])));
    try { localStorage.setItem('ep_sz', emojiSize); } catch(e) {}
    applySize(); exitCmd(); return;
  }
  const bufMatch = c.match(/^set\s+buf\s+(\d+)$/);
  if (bufMatch) {
    bufHeight = Math.max(26, parseInt(bufMatch[1]));
    try { localStorage.setItem('ep_bh', bufHeight); } catch(e) {}
    applyBufHeight(); exitCmd(); return;
  }
  const winMatch = c.match(/^set\s+win\s+(\d+)\s+(\d+)$/);
  if (winMatch) {
    window.resizeTo(Math.max(80, parseInt(winMatch[1])), Math.max(80, parseInt(winMatch[2])));
    exitCmd(); return;
  }
  exitCmd();
}

// ════════════════════════════════════════════════════════
//  BUILD VIS LIST
// ════════════════════════════════════════════════════════
function buildVis() {
  vis = [];
  const q = srchQ.trim().toLowerCase();

  if (q) {
    // Search across all categories
    CATS.forEach(c => {
      if (c.key === '_top' || !DATA[c.key]) return;
      DATA[c.key].forEach(([e, d]) => {
        if (d.includes(q) || e.includes(q)) vis.push({e, d});
      });
    });
  } else if (cat === '_top') {
    const keys = Object.keys(usage).filter(e => getCount(e) > 0);
    keys.sort((a, b) => (usageScore(b) - usageScore(a)) || ((CANON[a] ?? 9999) - (CANON[b] ?? 9999)));
    if (!keys.length) {
      // Fall back to smileys if no usage yet
      vis = DATA.Smileys.map(([e,d]) => ({e,d}));
    } else {
      vis = keys.map(e => {
        const canon = Object.values(DATA).flat().find(p => p[0] === e);
        return {e, d: canon ? canon[1] : e};
      });
    }
  } else {
    vis = (DATA[cat] || []).map(([e,d]) => ({e,d}));
  }
}

// ════════════════════════════════════════════════════════
//  DRAW
// ════════════════════════════════════════════════════════
function drawGrid() {
  buildVis();
  if (gc >= vis.length) gc = Math.max(0, vis.length - 1);

  $gr.innerHTML = '';
  visPos = [];

  if (!vis.length) {
    const no = document.createElement('div');
    no.className = 'no-res'; no.textContent = 'No results';
    $gr.appendChild(no);
    return;
  }

  let _r = 0, _c = 0;

  const showLabels = !srchQ && cat !== '_top';

  if (showLabels) {
    const lbl = document.createElement('div');
    lbl.className = 'sec-lbl'; lbl.textContent = CATS.find(c => c.key === cat)?.label || cat;
    $gr.appendChild(lbl);
    _r++; _c = 0;
  }

  vis.forEach((item, i) => {
    const btn = document.createElement('button');
    btn.className = 'ebtn' + (i === gc ? ' focused' : '');
    btn.textContent = withTone(item.e);
    btn.title = item.d;

    const cnt = getCount(item.e);
    if (cnt) {
      const badge = document.createElement('span');
      badge.className = 'ubadge'; badge.textContent = cnt;
      btn.appendChild(badge);
    }

    btn.addEventListener('mouseenter', () => {
      $pe.textContent = withTone(item.e); $pn.textContent = item.d;
    });
    btn.addEventListener('click', (ev) => {
      if (ev.shiftKey) { doSend(withTone(item.e)); }
      else { bInsert(withTone(item.e)); drawBuf(); }
    });

    visPos.push({row: _r, col: _c});
    _c++;
    if (_c === COLS) { _c = 0; _r++; }

    $gr.appendChild(btn);
  });

  // Update preview for current cursor
  if (vis[gc]) { $pe.textContent = withTone(vis[gc].e); $pn.textContent = vis[gc].d; }
}

function drawBuf() {
  $bf.innerHTML = '';
  buf.forEach((line, li) => {
    const div = document.createElement('div');
    div.className = 'bline' + (li === bc.l ? ' cur' : '');

    if (!line.length && buf.length === 1) {
      const em = document.createElement('span');
      em.className = 'bempty'; em.textContent = 'empty buffer';
      div.appendChild(em);
    } else {
      line.forEach((em, ci) => {
        if (li === bc.l && ci === bc.c) {
          const cur = document.createElement('span');
          cur.className = 'bcur'; cur.textContent = '|';
          div.appendChild(cur);
        }
        div.appendChild(document.createTextNode(em));
      });
      // Cursor at end of line
      if (li === bc.l && bc.c === line.length) {
        const cur = document.createElement('span');
        cur.className = 'bcur'; cur.textContent = '|';
        div.appendChild(cur);
      }
    }

    $bf.appendChild(div);
  });
}

function drawUI() {
  // Mode badge
  $mb.textContent = mode === 'search' ? 'SEARCH' : mode === 'command' ? 'COMMAND' : mode === 'help' ? 'HELP' : 'NORMAL';
  $mb.style.color = mode === 'search' ? 'var(--s)' : mode === 'command' ? 'var(--c)' : mode === 'help' ? 'var(--acc)' : 'var(--n)';

  // Top bar elements
  $si.classList.toggle('gone', mode !== 'search');
  $sd.classList.toggle('gone', mode === 'search' || !srchQ);
  $cd.classList.toggle('gone', mode !== 'command');

  if (mode === 'search') {
    // input is visible, focus managed by enterSearch
  } else if (srchQ) {
    $sd.textContent = '/' + srchQ;
  }
  if (mode === 'command') {
    $cd.textContent = ':' + cmdTxt + '█';
  }

  // Pending key indicator
  const pendHint = pendKey ? ` [${pendKey}…]` : '';

  // Hints
  const skinHint = skinTone ? `  skin:${skinTone}` : '';
  if (mode === 'normal') {
    $ht.textContent = 'Tab:insert  Enter:send  /:search  [/]:cat  g1-0:jump  Esc:close' + pendHint + skinHint;
  } else if (mode === 'search') {
    $ht.textContent = 'Tab:insert  Enter:insert+send  Esc:exit' + skinHint;
  } else if (mode === 'command') {
    $ht.textContent = ':q discard  :wq save  :colorscheme <name>  :help  Esc:back';
  } else if (mode === 'help') {
    $ht.textContent = 'j/k: scroll  q/Esc: close';
  }

  drawBuf();
}

function setCat(key) {
  cat = key; srchQ = ''; $si.value = ''; gc = 0;
  drawGrid(); drawUI(); drawCats();
}

function drawCats() {
  $gc.innerHTML = '';
  CATS.forEach(c => {
    const btn = document.createElement('button');
    btn.className = 'cat-btn' + (c.key === cat && !srchQ ? ' active' : '');
    btn.textContent = c.icon; btn.title = c.label;
    btn.addEventListener('click', () => setCat(c.key));
    $gc.appendChild(btn);
  });
}

// ════════════════════════════════════════════════════════
//  KEY HANDLERS
// ════════════════════════════════════════════════════════
function onNormal(e) {
  const k = e.key;
  const sh = e.shiftKey;

  // Pending 'd' sequence
  if (pendKey === 'd') {
    clearTimeout(pendTmr);
    pendKey = null;
    if (k === 'd') { bDelLine(); drawGrid(); drawUI(); return; }
    if (k === 'G') { bDelAll(); drawGrid(); drawUI(); return; }
    // Unrecognized second key — fall through as normal
  }

  // Pending 'g' sequence — direct category jump
  if (pendKey === 'g') {
    clearTimeout(pendTmr);
    pendKey = null;
    if (/^[0-9]$/.test(k)) {
      const c = CATS[k === '0' ? 9 : parseInt(k) - 1];
      if (c) setCat(c.key);
      return;
    }
    // Unrecognized second key — fall through as normal
  }

  // Grid movement
  if (k === 'h' || k === 'ArrowLeft')  { e.preventDefault(); setGC(gc - 1); return; }
  if (k === 'l' || k === 'ArrowRight') { e.preventDefault(); setGC(gc + 1); return; }
  if (k === 'j' || k === 'ArrowDown')  { e.preventDefault(); gridByPos(+1); return; }
  if (k === 'k' || k === 'ArrowUp')    { e.preventDefault(); gridByPos(-1); return; }

  // Buffer cursor movement (Shift+hjkl or Shift+arrows)
  if ((k === 'H' || (k === 'ArrowLeft'  && sh))) { e.preventDefault(); bH(); drawBuf(); return; }
  if ((k === 'L' || (k === 'ArrowRight' && sh))) { e.preventDefault(); bL(); drawBuf(); return; }
  if ((k === 'J' || (k === 'ArrowDown'  && sh))) { e.preventDefault(); bJ(); drawBuf(); return; }
  if ((k === 'K' || (k === 'ArrowUp'    && sh))) { e.preventDefault(); bK(); drawBuf(); return; }

  if (k === 'Tab')    { e.preventDefault(); if (vis[gc]) { bInsert(withTone(vis[gc].e)); drawBuf(); } return; }
  if (k === 'Enter')  { e.preventDefault(); doSend(vis[gc] ? withTone(vis[gc].e) : null); return; }
  if (k === 'Escape') { e.preventDefault(); doCloseKeep(); return; }

  if (k === 'x' || (k === 'Backspace' && !sh)) { bDelBack(); drawGrid(); drawUI(); return; }
  if (k === 'Backspace' && sh) { bDelAll(); drawGrid(); drawUI(); return; }

  // 0–9 quick insert
  if (/^[0-9]$/.test(k)) {
    const idx = k === '0' ? 9 : parseInt(k) - 1;
    if (vis[idx]) { bInsert(withTone(vis[idx].e)); drawGrid(); drawUI(); }
    return;
  }

  if (k === 'd') {
    pendKey = 'd';
    pendTmr = setTimeout(() => { pendKey = null; drawUI(); }, 1200);
    drawUI(); return;
  }
  if (k === 'g') {
    pendKey = 'g';
    pendTmr = setTimeout(() => { pendKey = null; drawUI(); }, 1200);
    drawUI(); return;
  }
  if (k === '[') { const i = CATS.findIndex(c => c.key === cat); setCat(CATS[(i - 1 + CATS.length) % CATS.length].key); return; }
  if (k === ']') { const i = CATS.findIndex(c => c.key === cat); setCat(CATS[(i + 1) % CATS.length].key); return; }
  if (k === 'o') { bLineBelow(); drawBuf(); return; }
  if (k === 'O') { bLineAbove(); drawBuf(); return; }
  if (k === '/')  { e.preventDefault(); enterSearch(); return; }
  if (k === ':')  { e.preventDefault(); enterCmd(); return; }
}

function onSearch(e) {
  const k = e.key;
  if (k === 'Escape') { e.preventDefault(); exitSearch(); return; }
  if (k === 'Tab') {
    e.preventDefault();
    exitSearch();
    if (vis[0]) { bInsert(withTone(vis[0].e)); drawBuf(); }
    return;
  }
  if (k === 'Enter') {
    e.preventDefault();
    exitSearch();
    if (vis[0]) {
      bInsert(withTone(vis[0].e));
      if (bTotal() === 1) { doSend(null); return; }
      drawBuf();
    }
    return;
  }
  // Let browser handle typing into $si; update grid on input event
}

function onCommand(e) {
  const k = e.key;
  if (k === 'Tab')     { e.preventDefault(); cmdComplete(e.shiftKey ? -1 : 1); return; }
  if (k === 'Shift' || k === 'Control' || k === 'Alt' || k === 'Meta') return;
  resetTab();
  if (k === 'Escape')  { e.preventDefault(); exitCmd(); return; }
  if (k === 'Enter')   { e.preventDefault(); execCmd(); return; }
  if (k === 'Backspace') { cmdTxt = cmdTxt.slice(0, -1); drawUI(); return; }
  if (k.length === 1)  { cmdTxt += k; drawUI(); }
}

function onHelp(e) {
  const k = e.key;
  e.preventDefault();
  if (k === 'Escape' || k === 'q') { exitHelp(); return; }
  const box = document.getElementById('help-box');
  if (k === 'j' || k === 'ArrowDown')  box.scrollBy(0,  40);
  if (k === 'k' || k === 'ArrowUp')    box.scrollBy(0, -40);
}

document.addEventListener('keydown', e => {
  if (mode === 'help')    { onHelp(e);    return; }
  if (mode === 'normal')  { onNormal(e);  return; }
  if (mode === 'search')  { onSearch(e);  return; }
  if (mode === 'command') { onCommand(e); return; }
});

$si.addEventListener('input', () => {
  srchQ = $si.value;
  gc = 0;
  drawGrid();
  drawCats();
});

// ════════════════════════════════════════════════════════
//  INIT
// ════════════════════════════════════════════════════════
naturalColW = Math.round(window.outerWidth / COLS);
applyCols();
applySize();
applyBufHeight();
drawCats();
drawGrid();
drawUI();
</script>
</body>
</html>
