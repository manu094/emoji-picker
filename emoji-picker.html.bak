const CATS = [
  {key:'_top',       icon:'⭐', label:'Most Used'},
  {key:'Smileys',    icon:'😀', label:'Smileys'},
  {key:'Hands',      icon:'👋', label:'Hands'},
  {key:'People',     icon:'🧑', label:'People'},
  {key:'Animals',    icon:'🐶', label:'Animals'},
  {key:'Plants',     icon:'🌵', label:'Plants & Nature'},
  {key:'Food',       icon:'🍎', label:'Food & Drink'},
  {key:'Travel',     icon:'🚗', label:'Travel & Places'},
  {key:'Objects',    icon:'💡', label:'Objects'},
  {key:'Symbols',    icon:'❤️', label:'Symbols'},
  {key:'Activities', icon:'⚽', label:'Activities'},
  {key:'Flags',      icon:'🚩', label:'Flags'},
];

let COLS = 9;

// Canonical order for Most Used tiebreaker
const CANON = {};
let _ci = 0;
CATS.forEach(c => { if (c.key !== '_top' && DATA[c.key]) DATA[c.key].forEach(p => { CANON[p[0]] = _ci++; }); });

