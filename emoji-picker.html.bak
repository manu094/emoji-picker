    n:'#40a02b', s:'#df8e1d', c:'#8839ef'
  },
  gruvbox: {
    bg:'#282828', surf:'#3c3836', bord:'rgba(255,255,255,.08)',
    text:'#ebdbb2', muted:'#928374', acc:'#83a598',
    hover:'rgba(255,255,255,.06)', sel:'rgba(131,165,152,.22)',
    bufBg:'rgba(131,165,152,.04)', bufCur:'rgba(131,165,152,.08)',
    n:'#b8bb26', s:'#fabd2f', c:'#d3869b'
  },
  nord: {
    bg:'#2e3440', surf:'#3b4252', bord:'rgba(255,255,255,.08)',
    text:'#eceff4', muted:'#4c566a', acc:'#88c0d0',
    hover:'rgba(255,255,255,.06)', sel:'rgba(136,192,208,.22)',
    bufBg:'rgba(136,192,208,.04)', bufCur:'rgba(136,192,208,.08)',
    n:'#a3be8c', s:'#ebcb8b', c:'#b48ead'
  },
  dracula: {
    bg:'#282a36', surf:'#343746', bord:'rgba(255,255,255,.08)',
    text:'#f8f8f2', muted:'#6272a4', acc:'#8be9fd',
    hover:'rgba(255,255,255,.06)', sel:'rgba(139,233,253,.20)',
    bufBg:'rgba(139,233,253,.04)', bufCur:'rgba(139,233,253,.08)',
    n:'#50fa7b', s:'#f1fa8c', c:'#bd93f9'
  }
};

let currentTheme = 'mocha';

function applyTheme(name) {
  const t = THEMES[name];
  if (!t) return false;
  const s = document.documentElement.style;
  s.setProperty('--bg',      t.bg);
  s.setProperty('--surf',    t.surf);
  s.setProperty('--bord',    t.bord);
  s.setProperty('--text',    t.text);
  s.setProperty('--muted',   t.muted);
  s.setProperty('--acc',     t.acc);
  s.setProperty('--hover',   t.hover);
  s.setProperty('--sel',     t.sel);
  s.setProperty('--buf-bg',  t.bufBg);
  s.setProperty('--buf-cur', t.bufCur);
  s.setProperty('--n',       t.n);
  s.setProperty('--s',       t.s);
  s.setProperty('--c',       t.c);
  currentTheme = name;
  return true;
}

